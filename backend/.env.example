# Backend environment (copy to .env). Placeholders only -- never commit real values.
# The API verifies tokens with the public JWKS and reads data as the restricted `app_api` role.
# The SERVICE-ROLE key is OPTIONAL and only enables Owner-created accounts (POST /users). Set it only in the
# server's own environment / git-ignored .env -- never commit it, never use a VITE_* variable for it.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
# LOG_JSON=true                # default: JSON logs in production, readable logs otherwise

# Comma-separated explicit origins (no wildcard; no localhost in production)
CORS_ORIGINS=http://localhost:5173

# Postgres connection (Supabase). Use the pooler/direct connection string from your project settings.
# MUST log in as the restricted `app_api` role (NOT postgres / service_role) so RLS applies to every query.
# Setup: docs/authentication/SUPABASE_SETUP.md. Optional in development.
DATABASE_URL=

# Supabase Auth: JWT verification. Issuer and JWKS URL are derived from SUPABASE_URL when left empty
# (https://<ref>.supabase.co/auth/v1 and .../auth/v1/.well-known/jwks.json). Production requires https.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_JWKS_URL=
# Optional tuning (defaults shown)
# SUPABASE_JWT_AUDIENCE=authenticated
# JWKS_CACHE_TTL_SECONDS=600
# JWKS_REFRESH_COOLDOWN_SECONDS=60
# JWKS_MAX_STALE_SECONDS=3600
# JWT_LEEWAY_SECONDS=10

# Owner-created accounts (User Management -> New Branch User). Leave blank to disable; the API then answers 503.
SUPABASE_SERVICE_ROLE_KEY=
# Owner decision D20: mark Owner-created Branch Users' email as confirmed so they can sign in immediately.
# The same key also powers POST /auth/change-password (first-login password change). Never expose it to the frontend.
PROVISION_EMAIL_CONFIRMED=true
# Only for scripts/provision_account.py (Owner accounts); the Branch User form sends no email.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
