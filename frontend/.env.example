# Frontend environment (copy to .env.local). Only VITE_* variables are bundled into the browser build.
# Placeholders only -- never put a service-role key, database URL or any secret here.

# Base URL of the FastAPI backend, including the version prefix.
VITE_API_BASE_URL=http://localhost:8008/api/v1

# Supabase public settings. The anon/publishable key is public by design (data is protected by RLS and the API).
# Required in production builds. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
